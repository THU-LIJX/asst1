/bin/mkdir -p objs/
ispc -O3 --target=neon-i32x8 --arch=aarch64 --pic sqrt.ispc -o objs/sqrt_ispc.o -h objs/sqrt_ispc.h
clang++ main.cpp -I../common -Iobjs/ -O3 -std=c++11 -Wall -c -o objs/main.o
clang++ sqrtSerial.cpp -I../common -Iobjs/ -O3 -std=c++11 -Wall -c -o objs/sqrtSerial.o
clang++ ../common/ppm.cpp -I../common -Iobjs/ -O3 -std=c++11 -Wall -c -o objs/ppm.o
clang++ ../common/tasksys.cpp -I../common -Iobjs/ -O3 -std=c++11 -Wall -c -o objs/tasksys.o
clang++ -I../common -Iobjs/ -O3 -std=c++11 -Wall -o sqrt objs/main.o objs/sqrtSerial.o objs/sqrt_ispc.o objs/ppm.o objs/tasksys.o -lm -lpthread
